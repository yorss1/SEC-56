# Copia este archivo a .env solo si lo necesitas en local; no se versiona.
# En Cloudflare Pages estas variables se configuran en:
#   Settings > Environment variables (separadas para Production y Preview).
# Ningún valor de este archivo es secreto: el sitio es estático y no usa claves.

# demo (predeterminado) | produccion
# "produccion" falla la compilación si content/site.json no tiene la autorización
# de la dirección y si falta SITE_URL.
SITE_MODE=demo

# Dominio definitivo confirmado por la escuela, con https://. Vacío mientras no exista.
# Se usa para canonical, Open Graph, sitemap.xml y robots.txt (solo en modo produccion).
SITE_URL=

# Ruta base si el sitio no vive en la raíz del dominio (ej. /escuela/). Normalmente vacío.
BASE_PATH=

# URL https:// del servicio que RECIBE los mensajes del formulario de contacto.
# Vacío = el formulario no se muestra. Requiere además el aviso de privacidad aprobado.
CONTACT_FORM_ENDPOINT=

# Opcionales (desarrollo y pruebas)
# OUT_DIR=dist
# CONTENT_DIR=content
# BUILD_DATE=2026-01-15
# PORT=4173
